{
  "name": "aperitivi-urbani-public-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "data:sanitize": "node scripts/sanitize-catalog.mjs --output src/data/catalog.json",
    "pages:prepare": "node scripts/prepare-pages-media.mjs",
    "pages:deploy": "wrangler pages deploy dist --project-name aperitivi-urbani-catalogo --branch main",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
